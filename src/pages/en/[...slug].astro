---
import type { GetStaticPaths } from 'astro';
import PageContent from '../../components/PageContent.astro';
import { getPagesForLocale, pages, type PageId } from '../../data/site';

export const getStaticPaths: GetStaticPaths = () =>
	getPagesForLocale('en').map((pageId) => ({
		params: { slug: pages[pageId].slug.en },
		props: { pageId },
	}));

const { pageId } = Astro.props as { pageId: PageId };
---

<PageContent locale="en" pageId={pageId} />
