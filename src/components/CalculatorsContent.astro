---
import type { Locale } from '../data/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const tr = (ka: string, en: string): string => locale === 'ka' ? ka : en;

const text = locale === 'ka' 
	? { title: 'HVAC/R კალკულატორები', desc: 'საინჟინრო ინსტრუმენტების სრული ნაკრები კლიმატური სისტემებისთვის.' }
	: { title: 'HVAC/R Calculators', desc: 'Complete engineering toolset for climate systems.' };
---

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
	<div class="mb-10 max-w-3xl">
		<h2 class="georgian-caps text-3xl font-extrabold text-white sm:text-4xl">{text.title}</h2>
		<p class="mt-4 text-base leading-7 text-white/70 sm:text-lg sm:leading-8">
			{text.desc}
		</p>
	</div>

	<!-- ============================================== -->
	<!-- 1. SPACE CALCULATOR (ROOM BTU)                 -->
	<!-- ============================================== -->
	<div class="mb-20">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
			
			<!-- Left Side: Inputs -->
			<div class="lg:col-span-8 space-y-6">
				


				<!-- ROOM PARAMETERS -->
				<div class="bg-night-panel p-6 sm:p-8 rounded-3xl border border-white/5 shadow-panel transition-all duration-300">
					<div class="mb-8">
						<h3 class="text-2xl font-extrabold text-white mb-2 georgian-caps">{tr('თქვენი სივრცე', 'Your space')}</h3>
						<p class="text-sm text-white/50">{tr('ფართობი და სითბური დანაკარგები', 'Area and heat load')}</p>
					</div>

					<div class="space-y-8">
						<!-- Area Slider -->
						<div>
							<div class="flex justify-between items-end mb-4">
								<label class="text-sm font-bold text-white/80">{tr('ოთახის ფართობი', 'Room area')}</label>
								<div class="flex items-center gap-1 border-b border-white/20 pb-1">
									<input type="number" id="u-area-n" value="30" class="w-16 bg-transparent text-right font-bold text-white focus:outline-none u-trigger appearance-none" min="5" max="200">
									<span class="text-white/50 text-sm font-bold">{locale === 'ka' ? 'მ²' : 'm²'}</span>
								</div>
							</div>
							<input type="range" id="u-area-r" min="5" max="200" value="30" class="w-full accent-accent h-1.5 bg-white/10 rounded-lg appearance-none cursor-pointer u-trigger">
						</div>

						<!-- Height Slider -->
						<div>
							<div class="flex justify-between items-end mb-4">
								<label class="text-sm font-bold text-white/80">{tr('ჭერის სიმაღლე', 'Ceiling height')}</label>
								<div class="flex items-center gap-1 border-b border-white/20 pb-1">
									<input type="number" id="u-height-n" value="3.0" step="0.1" class="w-16 bg-transparent text-right font-bold text-white focus:outline-none u-trigger appearance-none" min="2" max="6">
									<span class="text-white/50 text-sm font-bold">{locale === 'ka' ? 'მ' : 'm'}</span>
								</div>
							</div>
							<input type="range" id="u-height-r" min="2" max="6" step="0.1" value="3.0" class="w-full accent-accent h-1.5 bg-white/10 rounded-lg appearance-none cursor-pointer u-trigger">
						</div>

						<!-- Sun Exposure (Radios) -->
						<div>
							<label class="block text-sm font-bold text-white/80 mb-3">{tr('მზის ზემოქმედება (გაგრილებისას)', 'Sun exposure (cooling)')}</label>
							<div class="grid grid-cols-3 gap-3">
								<label class="cursor-pointer">
									<input type="radio" name="u-sun" value="shade" class="peer sr-only u-trigger">
									<div class="flex flex-col items-center justify-center p-3 rounded-xl border border-white/10 bg-white/5 text-white/50 peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent transition-all text-center">
										<span class="text-xs sm:text-sm font-bold">{tr('ჩრდილში', 'Shaded')}</span>
									</div>
								</label>
								<label class="cursor-pointer">
									<input type="radio" name="u-sun" value="normal" checked class="peer sr-only u-trigger">
									<div class="flex flex-col items-center justify-center p-3 rounded-xl border border-white/10 bg-white/5 text-white/50 peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent transition-all text-center">
										<span class="text-xs sm:text-sm font-bold">{tr('საშუალო', 'Average')}</span>
									</div>
								</label>
								<label class="cursor-pointer">
									<input type="radio" name="u-sun" value="sun" class="peer sr-only u-trigger">
									<div class="flex flex-col items-center justify-center p-3 rounded-xl border border-white/10 bg-white/5 text-white/50 peer-checked:bg-fire peer-checked:text-white peer-checked:border-fire transition-all text-center">
										<span class="text-xs sm:text-sm font-bold">{tr('მზიანი', 'Sunny')}</span>
									</div>
								</label>
							</div>
						</div>

						<!-- Insulation (Radios) -->
						<div>
							<label class="block text-sm font-bold text-white/80 mb-3">{tr('თბოიზოლაცია', 'Insulation')}</label>
							<div class="grid grid-cols-3 gap-3">
								<label class="cursor-pointer">
									<input type="radio" name="u-insul" value="good" class="peer sr-only u-trigger">
									<div class="flex flex-col items-center justify-center p-3 rounded-xl border border-white/10 bg-white/5 text-white/50 peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent transition-all text-center">
										<span class="text-xs sm:text-sm font-bold">{tr('კარგი', 'Good')}</span>
									</div>
								</label>
								<label class="cursor-pointer">
									<input type="radio" name="u-insul" value="normal" checked class="peer sr-only u-trigger">
									<div class="flex flex-col items-center justify-center p-3 rounded-xl border border-white/10 bg-white/5 text-white/50 peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent transition-all text-center">
										<span class="text-xs sm:text-sm font-bold">{tr('საშუალო', 'Average')}</span>
									</div>
								</label>
								<label class="cursor-pointer">
									<input type="radio" name="u-insul" value="poor" class="peer sr-only u-trigger">
									<div class="flex flex-col items-center justify-center p-3 rounded-xl border border-white/10 bg-white/5 text-white/50 peer-checked:bg-danger peer-checked:text-white peer-checked:border-danger transition-all text-center">
										<span class="text-xs sm:text-sm font-bold">{tr('სუსტი', 'Poor')}</span>
									</div>
								</label>
							</div>
						</div>

						<!-- People & Tech -->
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
							<div class="flex items-center justify-between bg-white/5 border border-white/10 p-3 rounded-xl">
								<div class="text-sm font-bold text-white/80">{tr('ადამიანები', 'People')}<br/><span class="text-xs text-white/40 font-normal">{tr('ოთახში', 'in the room')}</span></div>
								<div class="flex items-center gap-4">
									<button type="button" class="counter-btn text-white/50 hover:text-white cursor-pointer" data-target="u-people" data-step="-1"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14"/></svg></button>
									<input type="number" id="u-people" value="2" class="w-6 bg-transparent text-center font-bold text-white focus:outline-none u-trigger appearance-none" readonly>
									<button type="button" class="counter-btn text-white/50 hover:text-white cursor-pointer" data-target="u-people" data-step="1"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5v14"/></svg></button>
								</div>
							</div>
							<div class="flex items-center justify-between bg-white/5 border border-white/10 p-3 rounded-xl">
								<div class="text-sm font-bold text-white/80">{tr('ტექნიკა', 'Appliances')}<br/><span class="text-xs text-white/40 font-normal">PC, TV, etc.</span></div>
								<div class="flex items-center gap-4">
									<button type="button" class="counter-btn text-white/50 hover:text-white cursor-pointer" data-target="u-tech" data-step="-1"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14"/></svg></button>
									<input type="number" id="u-tech" value="1" class="w-6 bg-transparent text-center font-bold text-white focus:outline-none u-trigger appearance-none" readonly>
									<button type="button" class="counter-btn text-white/50 hover:text-white cursor-pointer" data-target="u-tech" data-step="1"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5v14"/></svg></button>
								</div>
							</div>
						</div>
						
						<!-- Vitrage Toggle -->
						<div class="flex items-center justify-between border-t border-white/10 pt-5">
							<div>
								<div class="text-sm font-bold text-white">{tr('ვიტრაჟები / დიდი ფანჯრები', 'Glazing / large windows')}</div>
								<div class="text-xs text-white/50">{tr('ამატებს მზის სითბურ დატვირთვას.', 'Adds solar heat gain.')}</div>
							</div>
							<label class="relative inline-flex items-center cursor-pointer">
								<input type="checkbox" id="u-vitrage" class="sr-only peer u-trigger">
								<div class="w-11 h-6 shrink-0 bg-black/50 rounded-full peer peer-checked:bg-accent relative after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full"></div>
							</label>
						</div>
						<!-- Top Floor Toggle -->
						<div class="flex items-center justify-between border-t border-white/10 pt-5 mt-5">
							<div>
								<div class="text-sm font-bold text-white">{tr('ბოლო სართული / სახურავქვეშ', 'Top floor / below the roof')}</div>
								<div class="text-xs text-white/50">{tr('ამატებს სახურავის სითბურ დანაკარგებს.', 'Adds heat loss through the roof.')}</div>
							</div>
							<label class="relative inline-flex items-center cursor-pointer">
								<input type="checkbox" id="u-roof" class="sr-only peer u-trigger">
								<div class="w-11 h-6 shrink-0 bg-black/50 rounded-full peer peer-checked:bg-accent relative after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full"></div>
							</label>
						</div>

					</div>
				</div>

			</div>

			<!-- Right Side: Sticky Results Card -->
			<div class="lg:col-span-4 relative">
				<div class="bg-gradient-to-br from-[#1a2b4c] to-[#0d172e] p-6 sm:p-8 rounded-3xl border border-white/10 shadow-2xl sticky top-24 transition-all" id="res-panel">
					
					<div id="res-title" class="text-white/70 text-sm font-bold flex items-center gap-2 mb-2 georgian-caps">
						<svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
						{tr('საჭირო სიმძლავრე (მაქს.)', 'Required capacity (max.)')}
					</div>
					
					<div class="flex items-baseline gap-2 text-white overflow-hidden">
						<span id="res-btu" class="text-4xl sm:text-5xl font-extrabold tracking-tight">0</span>
					</div>
					<div id="res-kw" class="text-accent text-sm font-bold mt-1 mb-6"></div>

					<div class="bg-white/10 rounded-2xl p-5 border border-white/10 mb-6 backdrop-blur-md shadow-inner relative overflow-hidden">
						<div id="res-rec-label" class="text-white/70 text-xs font-bold mb-1">{tr('რეკომენდებული კონდიციონერი', 'Recommended air conditioner')}</div>
						<div id="res-rec" class="text-white text-xl sm:text-2xl font-bold">0</div>
					</div>
					
					<div class="text-[11px] text-white/50 leading-relaxed flex items-start gap-2">
						<svg class="size-4 shrink-0 mt-0.5 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
						{tr('ეს არის საორიენტაციო სტანდარტული სიმძლავრე არჩეული კლიმატური ზონის გათვალისწინებით.', 'This is an estimated standard capacity based on the selected climate zone.')}
					</div>

				</div>
			</div>

		</div>
	</div>


	<!-- ============================================== -->
	<!-- 2. DIAGNOSTICS & STANDALONE TOOLS              -->
	<!-- ============================================== -->
	<div class="border-t border-white/10 pt-16">
		<h3 class="mb-10 text-2xl font-extrabold text-white georgian-caps">{tr('საინჟინრო ინსტრუმენტები', 'Engineering tools')}</h3>
		
		<!-- CATEGORY 1: INSTALLATION -->
		<div class="mb-14">
			<h4 class="text-accent text-lg font-bold mb-6 flex items-center gap-2 georgian-caps">
				<svg class="size-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
				{tr('სამონტაჟო გამოთვლები', 'Installation calculations')}
			</h4>
			<div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3 items-start">
				
				<!-- TOOL: Condensate Pump -->
				<div class="flex flex-col min-h-[400px] rounded-2xl border border-white/10 bg-night-panel p-6 shadow-panel hover:bg-white/5 transition-colors">
					<div class="mb-6 flex items-center gap-3">
						<div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-blue-500/20 text-blue-400">
							<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22a5 5 0 0 0 5-5c0-2-2.5-7-5-12-2.5 5-5 10-5 12a5 5 0 0 0 5 5z"/></svg>
						</div>
						<h4 class="text-md font-bold text-white leading-tight">{tr('კონდენსატის ტუმბო', 'Condensate pump')}</h4>
					</div>
					<div class="space-y-4 text-sm">
						<div>
							<label class="mb-1.5 block font-semibold text-white/70">{tr('კონდიციონერის სიმძლავრე', 'Air-conditioner capacity')}</label>
							<select id="tl-cond-cap" class="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white focus:border-accent focus:outline-none [&>option]:bg-night">
								<option value="9000">9 000 BTU</option>
								<option value="12000">12 000 BTU</option>
								<option value="18000" selected>18 000 BTU</option>
								<option value="24000">24 000 BTU</option>
								<option value="36000">36 000 BTU</option>
								<option value="48000">48 000 BTU</option>
								<option value="60000">60 000 BTU</option>
							</select>
						</div>
						<div class="relative">
							<label class="mb-1.5 block font-semibold text-white/70">{tr('კლიმატი / ტენიანობა', 'Climate / humidity')}</label>
							<select id="tl-cond-hum" class="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white focus:border-accent focus:outline-none [&>option]:bg-night">
								<option value="0.5">{tr('მშრალი (0.5)', 'Dry (0.5)')}</option>
								<option value="0.8" selected>{tr('საშუალო (0.8)', 'Average (0.8)')}</option>
								<option value="1.2">{tr('ტენიანი (1.2)', 'Humid (1.2)')}</option>
								<option value="custom">{tr('ხელით შეყვანა', 'Enter manually')}</option>
							</select>
							<input type="number" id="tl-cond-custom" class="hidden mt-2 w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white focus:border-accent focus:outline-none" placeholder={tr('ტენიანობა % (მაგ: 60)', 'Humidity % (e.g. 60)')} step="1">
						</div>
					</div>
					<div class="mt-auto pt-6">
						<button id="btn-tl-cond" class="w-full rounded-xl bg-accent py-2 text-sm font-bold text-white transition-all hover:bg-accent/90 active:scale-[0.98]">{tr('გამოთვლა', 'Calculate')}</button>
						<div id="res-tl-cond" class="hidden mt-3 rounded-xl border border-white/10 bg-black/20 p-3">
							<div id="text-tl-cond" class="text-xs leading-relaxed text-white"></div>
						</div>
					</div>
				</div>

				<!-- TOOL: Pipe Insulation -->
				<div class="flex flex-col min-h-[400px] rounded-2xl border border-white/10 bg-night-panel p-6 shadow-panel hover:bg-white/5 transition-colors">
					<div class="mb-6 flex items-center gap-3">
						<div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-indigo-500/20 text-indigo-400">
							<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
						</div>
						<h4 class="text-md font-bold text-white leading-tight">{tr('მილის თბოიზოლაცია', 'Pipe insulation')}<br/><span class="text-[10px] text-white/50 font-normal">{tr('(ნამის წერტილით დაცვა)', '(dew-point protection)')}</span></h4>
					</div>
					<div class="space-y-4 text-sm">
						<div>
							<label class="mb-1.5 block font-semibold text-white/70">{tr('გარემოს ტემპერატურა (°C)', 'Ambient temperature (°C)')}</label>
							<input type="number" id="tl-insul-t" class="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white focus:border-accent focus:outline-none" value="35">
						</div>
						<div>
							<label class="mb-1.5 block font-semibold text-white/70">{tr('ფარდობითი ტენიანობა (%)', 'Relative humidity (%)')}</label>
							<input type="number" id="tl-insul-rh" class="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white focus:border-accent focus:outline-none" value="60">
						</div>
					</div>
					<div class="mt-auto pt-6">
						<button id="btn-tl-insul" class="w-full rounded-xl bg-accent py-2 text-sm font-bold text-white transition-all hover:bg-accent/90 active:scale-[0.98]">{tr('გამოთვლა', 'Calculate')}</button>
						<div id="res-tl-insul" class="hidden mt-3 rounded-xl border border-white/10 bg-black/20 p-3">
							<div id="text-tl-insul" class="text-xs leading-relaxed text-white"></div>
						</div>
					</div>
				</div>

				<!-- TOOL: Electrical General -->
				<div class="flex flex-col min-h-[400px] rounded-2xl border border-white/10 bg-night-panel p-6 shadow-panel hover:bg-white/5 transition-colors">
					<div class="mb-6 flex items-center gap-3">
						<div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-purple-500/20 text-purple-400">
							<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
						</div>
						<h4 class="text-md font-bold text-white leading-tight">{tr('ელ. კაბელი და ძაბვა', 'Electrical cable and voltage')}<br/><span class="text-[10px] text-white/50 font-normal">{tr('(უნივერსალური გამოთვლა)', '(universal calculation)')}</span></h4>
					</div>
					<div class="space-y-4 text-sm">
						<div class="grid grid-cols-2 gap-3">
							<div>
								<label class="mb-1.5 block font-semibold text-white/70 text-[11px]">{tr('ძაბვა (Volt)', 'Voltage (V)')}</label>
								<input type="number" id="tl-elec-v" class="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white focus:border-accent focus:outline-none" value="220">
							</div>
							<div>
								<label class="mb-1.5 block font-semibold text-white/70 text-[11px]">{tr('დენი (Amps)', 'Current (A)')}</label>
								<input type="number" id="tl-elec-a" class="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white focus:border-accent focus:outline-none" placeholder={tr('მაგ. 10', 'e.g. 10')}>
							</div>
						</div>
						<div class="grid grid-cols-2 gap-3">
							<div>
								<label class="mb-1.5 block font-semibold text-white/70 text-[11px]">{tr('მანძილი (მ)', 'Distance (m)')}</label>
								<input type="number" id="tl-elec-dist" class="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white focus:border-accent focus:outline-none" placeholder={tr('სიგრძე', 'Length')}>
							</div>
							<div>
