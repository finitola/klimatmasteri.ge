<script>
	const isEnglish = document.documentElement.lang === 'en';
	const tr = (ka: string, en: string): string => isEnglish ? en : ka;
	// ----------------------------------------------------
	// 1. SPACE CALCULATOR LOGIC
	// ----------------------------------------------------
	
	const syncInput = (sliderId: string, numberId: string) => {
		const s = document.getElementById(sliderId) as HTMLInputElement;
		const n = document.getElementById(numberId) as HTMLInputElement;
		if (s && n) {
			s.addEventListener('input', (e) => { n.value = (e.target as HTMLInputElement).value; });
			n.addEventListener('input', (e) => { s.value = (e.target as HTMLInputElement).value; });
		}
	};
	syncInput('u-area-r', 'u-area-n');
	syncInput('u-height-r', 'u-height-n');

	document.querySelectorAll('.counter-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const targetId = (e.currentTarget as HTMLButtonElement).dataset.target;
			const step = parseInt((e.currentTarget as HTMLButtonElement).dataset.step || "0");
			const input = document.getElementById(targetId || "") as HTMLInputElement;
			if (input) {
				let v = parseInt(input.value) || 0;
				v += step;
				if (v < 0) v = 0;
				input.value = String(v);
				updateUnified(); 
			}
		});
	});

	document.querySelectorAll('.u-trigger').forEach(el => {
		el.addEventListener('input', updateUnified);
		el.addEventListener('change', updateUnified);
	});

	function updateUnified() {
		const area = parseFloat((document.getElementById('u-area-n') as HTMLInputElement).value) || 0;
		const height = parseFloat((document.getElementById('u-height-n') as HTMLInputElement).value) || 0;
		if (area <= 0 || height <= 0) return;

		const insul = (document.querySelector('input[name="u-insul"]:checked') as HTMLInputElement).value;
		const sun = (document.querySelector('input[name="u-sun"]:checked') as HTMLInputElement).value;
		const people = parseInt((document.getElementById('u-people') as HTMLInputElement).value) || 0;
		const tech = parseInt((document.getElementById('u-tech') as HTMLInputElement).value) || 0;
		const roof = (document.getElementById('u-roof') as HTMLInputElement).checked;
		const vitrageElement = document.getElementById('u-vitrage') as HTMLInputElement;
		const vitrage = vitrageElement ? vitrageElement.checked : false;

		// 1. Sensible Cooling Load (Aligned with user preferred reference)
		let baseCoolingWm3 = 30; // Average
		if (insul === 'good') baseCoolingWm3 = 25;
		if (insul === 'poor') baseCoolingWm3 = 40;

		let sunFactor = 1.0;
		if (sun === 'shade') sunFactor = 0.9;
		if (sun === 'sun') sunFactor = 1.15;
		
		const volume = area * height;
		let envelopeCoolingW = (volume * baseCoolingWm3) * sunFactor;
		if (roof) envelopeCoolingW *= 1.15; // +15% for roof
		if (vitrage) envelopeCoolingW *= 1.25; // +25% for huge windows

		// Internal gains
		const peopleCoolingW = people * 100;
		const techCoolingW = tech * 100;

		const totalCoolingW = envelopeCoolingW + peopleCoolingW + techCoolingW;

		// 2. Heating Load
		let baseHeatingWm3 = 35; 
		if (insul === 'good') baseHeatingWm3 = 28;
		if (insul === 'poor') baseHeatingWm3 = 45;
		
		let envelopeHeatingW = volume * baseHeatingWm3;
		if (roof) envelopeHeatingW *= 1.20;
		if (vitrage) envelopeHeatingW *= 1.15; 

		const totalHeatingW = envelopeHeatingW;

		const coolingBtu = totalCoolingW * 3.41214;
		const heatingBtu = totalHeatingW * 3.41214;

		// 3. Recommended Unit Logic (Overclocking thresholds)
		let recommended = "";
		
		if (coolingBtu <= 10500) recommended = "9,000 BTU";
		else if (coolingBtu <= 14500) recommended = "12,000 BTU";
		else if (coolingBtu <= 20500) recommended = "18,000 BTU";
		else if (coolingBtu <= 27000) recommended = "24,000 BTU";
		else if (coolingBtu <= 33000) recommended = "30,000 BTU";
		else if (coolingBtu <= 40000) recommended = "36,000 BTU";
		else if (coolingBtu <= 52000) recommended = "48,000 BTU";
		else if (coolingBtu <= 65000) recommended = "60,000 BTU";
		else {
			recommended = `<span class="text-xl">${tr('რამდენიმე აგრეგატი', 'Multiple units')}</span><br/><span class="text-sm font-normal text-white/70 mt-1 block">${tr('საერთო სიმძლავრე:', 'Total capacity:')} ${Math.ceil(coolingBtu/1000)*1000} BTU ${tr('-მდე', 'or higher')}</span>`;
		}

		// Update UI
		const uiBtu = document.getElementById('res-btu');
		if(uiBtu) uiBtu.innerHTML = `${Math.round(Math.max(coolingBtu, heatingBtu)).toLocaleString()} <span class="text-xl font-semibold text-white">${tr('BTU/სთ', 'BTU/h')}</span>`;

		const uiKw = document.getElementById('res-kw');
		if(uiKw) {
			uiKw.innerHTML = `
				<div class="flex flex-col gap-1.5 mt-2 text-sm text-white/90 font-medium">
					<span class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-blue-400"></div>${tr('გაგრილება:', 'Cooling:')} <strong class="text-blue-400">${(totalCoolingW / 1000).toFixed(1)} ${tr('კვტ', 'kW')}</strong></span>
					<span class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-fire"></div>${tr('გათბობა:', 'Heating:')} <strong class="text-fire">${(totalHeatingW / 1000).toFixed(1)} ${tr('კვტ', 'kW')}</strong></span>
				</div>
			`;
		}

		const uiRec = document.getElementById('res-rec');
		if(uiRec) {
			if(coolingBtu > 65000) {
				uiRec.innerHTML = recommended;
			} else {
				uiRec.innerHTML = `${recommended} <span class="text-lg">${tr('კლასი', 'class')}</span>`;
			}
		}
	}
	
	updateUnified();


	// ----------------------------------------------------
	// 2. STANDALONE ENGINEERING TOOLS LOGIC
	// ----------------------------------------------------

	// Condensate Pump
	const condHumSelect = document.getElementById('tl-cond-hum') as HTMLSelectElement;
	const condCustomInput = document.getElementById('tl-cond-custom') as HTMLInputElement;
	condHumSelect?.addEventListener('change', () => {
		if(condHumSelect.value === 'custom') {
			condCustomInput?.classList.remove('hidden');
		} else {
			condCustomInput?.classList.add('hidden');
		}
	});

	document.getElementById('btn-tl-cond')?.addEventListener('click', () => {
		const cap = parseFloat((document.getElementById('tl-cond-cap') as HTMLSelectElement).value);
		let hum = parseFloat(condHumSelect.value);
		if(condHumSelect.value === 'custom') {
			let rh = parseFloat(condCustomInput.value);
			if (!isNaN(rh)) {
				hum = 0.5 + ((rh - 40) * (0.7 / 30));
				if (hum < 0.1) hum = 0.1;
			} else {
				hum = NaN;
			}
		}
		if (isNaN(cap) || isNaN(hum)) return;

		const targetW = cap / 3.41214;
		const lph = (targetW / 1000) * hum;
		const pump = Math.max(10, Math.ceil(lph * 3));
		
		const box = document.getElementById('res-tl-cond');
		const text = document.getElementById('text-tl-cond');
		box?.classList.remove('hidden');
		const pipeNote = lph < 10 ? ` (${tr('სტანდარტული გოფრე', 'standard corrugated pipe')})` : '';
		const actualPipe = lph < 10 ? `Ø16${tr('მმ', 'mm')}` : `Ø20${tr('მმ', 'mm')}`;
		if(text) text.innerHTML = `
			<div class="text-center">
				<div class="text-sm text-white/80">${tr('კონდენსატი:', 'Condensate:')} <strong class="text-lg text-accent">${lph.toFixed(2)} ${tr('ლ/სთ', 'L/h')}</strong></div>
				<div class="mt-1 text-[11px] text-white/50">(${tr('დატვირთვა:', 'Load:')} ${(targetW / 1000).toFixed(1)} kW)</div>
			</div>
			<div class="my-3 border-t border-dashed border-accent/50"></div>
			<div class="rounded-lg border border-white/10 bg-white/5 p-3">
				<div class="mb-2 flex items-center gap-2 font-bold text-accent">
					<svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
					${tr('რეკომენდაცია:', 'Recommendation:')}
				</div>
				<ul class="list-disc space-y-1.5 pl-5 text-white/90">
					<li>${tr('მილი:', 'Pipe:')} <strong class="text-white">${actualPipe}${pipeNote}</strong></li>
					<li>${tr('ტუმბო:', 'Pump:')} <strong class="text-white">${tr('მინ.', 'min.')} ${pump} ${tr('ლ/სთ', 'L/h')} (Silent type)</strong></li>
				</ul>
				<div class="mt-3 flex items-start gap-2 text-[11px] italic text-white/60">
					<svg class="mt-0.5 size-3.5 shrink-0 text-fire" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V17h6v-.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/></svg>
					<span>${tr('რჩევა: თვითდინებისას დაიცავით დახრა (1სმ / 1 მეტრზე).', 'Tip: maintain a downward slope for gravity drainage (1 cm per metre).')}</span>
				</div>
			</div>
		`;
	});

	// Pipe Insulation
	document.getElementById('btn-tl-insul')?.addEventListener('click', () => {
		const t = parseFloat((document.getElementById('tl-insul-t') as HTMLInputElement).value);
		const rh = parseFloat((document.getElementById('tl-insul-rh') as HTMLInputElement).value);
		
		const a = 17.27, b = 237.7;
		const alpha = ((a * t) / (b + t)) + Math.log(rh / 100);
		const dp = (b * alpha) / (a - alpha);

		let thick = 9, warning = '';
		if (dp > 20) thick = 13;
		if (dp > 25) thick = 19;
		if (dp > 29) { thick = 25; warning = `<br/><span class="text-fire text-[10px]">! ${tr('ექსტრემალური კონდენსაციის რისკი', 'Extreme condensation risk')}</span>`; }

		const box = document.getElementById('res-tl-insul');
		const text = document.getElementById('text-tl-insul');
		box?.classList.remove('hidden');
		if(text) text.innerHTML = `${tr('სისქე (K-Flex):', 'Thickness (K-Flex):')} <strong class="text-accent">${thick} ${tr('მმ', 'mm')}</strong><br/><span class="text-white/50 text-[11px]">${tr('ნამის წერტილი:', 'Dew point:')} ~${Math.round(dp)}°C</span>${warning}`;
	});

	// Electrical (General)
	document.getElementById('btn-tl-elec')?.addEventListener('click', () => {
		const volt = parseFloat((document.getElementById('tl-elec-v') as HTMLInputElement).value);
		const amps = parseFloat((document.getElementById('tl-elec-a') as HTMLInputElement).value);
		const dist = parseFloat((document.getElementById('tl-elec-dist') as HTMLInputElement).value);
		const mat = (document.getElementById('tl-elec-mat') as HTMLSelectElement).value;
		const mmInput = (document.getElementById('tl-elec-mm') as HTMLSelectElement).value;
		
		const box = document.getElementById('res-tl-elec');
		const text = document.getElementById('text-tl-elec');
		
		if (isNaN(volt) || isNaN(amps) || isNaN(dist)) {
			box?.classList.remove('hidden');
			if(text) text.innerHTML = `<span class="text-danger font-bold">${tr('შეავსეთ ყველა ველი!', 'Complete all fields.')}</span>`;
			return;
		}

		const p = mat === 'cu' ? 0.0175 : 0.028;
		const sizes = [1.5, 2.5, 4.0, 6.0, 10.0, 16.0];
		
		const limitsCu: Record<number, number> = {1.5: 16, 2.5: 25, 4: 32, 6: 40, 10: 63, 16: 80};
		const limitsAl: Record<number, number> = {1.5: 10, 2.5: 20, 4: 25, 6: 32, 10: 50, 16: 63};
		const limits = mat === 'cu' ? limitsCu : limitsAl;

		let selectedMm = 0;
		let warning = '';

		if (mmInput === 'auto') {
			selectedMm = 16.0; 
			for (let s of sizes) {
				if (s === 1.5 && mat === 'al') continue; 
				if (amps <= limits[s]) {
					const vd = (2 * dist * amps * p) / s;
					if ((vd / volt) <= 0.03) {
						selectedMm = s;
						break;
					}
				}
			}
			if (amps > limits[selectedMm]) {
				warning = `<br/><span class="text-danger text-[10px] font-bold">! ${tr('დენი აღემატება კაბელის გამტარობას', 'Current exceeds the cable capacity')}</span>`;
			}
		} else {
			selectedMm = parseFloat(mmInput);
			if (amps > limits[selectedMm]) {
				warning = `<br/><span class="text-danger text-[10px] font-bold">! ${tr('საფრთხე: კვეთი მცირეა ამ დენისთვის', 'Warning: the cross-section is too small for this current')} (max. ~${limits[selectedMm]}A)</span>`;
			}
		}

		const vDrop = (2 * dist * amps * p) / selectedMm;
		const vDropPct = (vDrop / volt) * 100;
		const vDropCls = vDropPct > 5 ? 'text-danger' : vDropPct > 3 ? 'text-fire' : 'text-green-400';
		
		let breaker = 10;
		const bSizes = [10, 16, 20, 25, 32, 40, 50, 63, 80];
		for (let b of bSizes) {
			if (b >= amps && b <= limits[selectedMm]) {
				breaker = b;
				break;
			}
		}
		if (amps > limits[selectedMm]) breaker = limits[selectedMm]; 
		
		box?.classList.remove('hidden');
		if(text) text.innerHTML = `
			${tr('კაბელი:', 'Cable:')} <strong class="text-accent">${selectedMm} ${tr('მმ²', 'mm²')}</strong> <span class="text-white/50 text-[10px]">(${mat === 'cu' ? tr('სპილენძი', 'copper') : tr('ალუმინი', 'aluminum')})</span><br/>
			${tr('რეკ. ავტომატი:', 'Recommended breaker:')} <strong class="text-accent">${breaker}A</strong><br/>
			<div class="mt-2 pt-2 border-t border-white/10">
				${tr('ძაბვის ვარდნა:', 'Voltage drop:')} <strong class="${vDropCls}">${vDrop.toFixed(1)}V (${vDropPct.toFixed(1)}%)</strong><br/>
				${tr('ბოლოში ძაბვა:', 'Voltage at the end:')} <strong class="text-white">${(volt - vDrop).toFixed(1)}V</strong>
			</div>
			${warning}
		`;
	});

	// ROI
	document.getElementById('btn-tl-roi')?.addEventListener('click', () => {
		const cap = parseFloat((document.getElementById('tl-roi-cap') as HTMLInputElement).value);
		const hrs = parseFloat((document.getElementById('tl-roi-hrs') as HTMLInputElement).value);
		const trf = parseFloat((document.getElementById('tl-roi-trf') as HTMLInputElement).value);
		
		const box = document.getElementById('res-tl-roi');
		const text = document.getElementById('text-tl-roi');
		
		if (isNaN(cap) || isNaN(hrs) || isNaN(trf)) return;

		const kwHeat = (cap / 3.41214) / 1000;
		const pOnOff = kwHeat / 2.8; 
		const pInv = kwHeat / 3.6;
		
		const costOnOff = pOnOff * hrs * 30 * trf;
		const costInv = pInv * hrs * 30 * trf;
		const saveMonth = costOnOff - costInv;
		const saveYear = saveMonth * 12;
		
		box?.classList.remove('hidden');
		if(text) text.innerHTML = `
			<div class="mb-3 text-white/80 font-medium">${tr('ხარჯი თვეში:', 'Monthly cost:')}</div>
			<div class="flex items-center gap-2 mb-2">
				<div class="w-3 h-3 rounded-full bg-danger shrink-0"></div>
				<span class="text-danger/90">On/Off (${tr('ჩვეულებრივი', 'standard')}): <strong class="text-danger">${costOnOff.toFixed(2)} ₾</strong></span>
			</div>
			<div class="flex items-center gap-2 mb-5">
				<div class="w-3 h-3 rounded-full bg-green-500 shrink-0"></div>
				<span class="text-green-500/90">Inverter (${tr('ეკონომიური', 'efficient')}): <strong class="text-green-400">${costInv.toFixed(2)} ₾</strong></span>
			</div>
			
			<div class="border-t border-dashed border-accent/50 pt-4 text-center">
				<div class="text-white/80 font-medium mb-2">${tr('თქვენი ეკონომია:', 'Your savings:')}</div>
				<div class="text-2xl font-bold text-green-400 flex items-center justify-center gap-2 mb-1">
					<svg class="size-6 text-fire" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v8"/><path d="M10.5 9.5h3"/><path d="M10.5 14.5h3"/></svg>
					${Math.round(saveMonth)} ₾ <span class="text-sm text-white/70 font-normal">${tr('/თვეში', '/month')}</span>
				</div>
				<div class="text-[13px] text-white/60 flex items-center justify-center gap-1.5">
					( <svg class="size-4 text-accent/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
					${tr('წელიწადში:', 'per year:')} ~${Math.round(saveYear)} ₾ )
				</div>
			</div>
		`;
	});
	// P-T API...
	(window as any).ptCache = (window as any).ptCache || new Map();
	
	async function getDanfossTemp(ref: string, press: number, unit: string, phase: string): Promise<number | null> {
		const refIdMap: Record<string, string> = { 'R410A': 'r410a', 'R32': 'r32', 'R22': 'r22' };
		const refId = refIdMap[ref];
		const calcPhase = ref === 'R410A' ? phase : 'dew';
		const pKey = Math.round(press * 100) / 100;
		const cacheKey = `${ref}|${unit}|${calcPhase}|${pKey}`;

		if ((window as any).ptCache.has(cacheKey)) return (window as any).ptCache.get(cacheKey);
		
		try {
			const res = await fetch(`https://reftools.danfoss.com/api/ref-slider/temperature?refId=${refId}`, {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({
					pressure: String(pKey), refId, temperatureUnit: 'celsius',
					pressureUnit: unit, pressureReferencePoint: 'gauge',
					pressureCalculationPoint: calcPhase, gaugeType: 'dry', altitudeInMeter: 0
				})
			});
			if (res.ok) {
				const t = parseFloat(await res.text());
				if (Number.isFinite(t)) {
					(window as any).ptCache.set(cacheKey, t);
					return t;
				}
			}
		} catch (e) {
			console.error("Danfoss API Error:", e);
		}
		return null;
	}

	let ptTimer: any = null;
	document.getElementById('pt-ref')?.addEventListener('change', (e) => {
		const val = (e.target as HTMLSelectElement).value;
		const wrap = document.getElementById('pt-phase-wrap');
		if(wrap) {
			if (val === 'R410A') wrap.classList.remove('hidden');
			else wrap.classList.add('hidden');
		}
		calculatePT();
	});
	['pt-press', 'pt-unit', 'pt-phase'].forEach(id => {
		document.getElementById(id)?.addEventListener('input', calculatePT);
	});

	async function calculatePT() {
		const ref = (document.getElementById('pt-ref') as HTMLSelectElement).value;
		const pressVal = parseFloat((document.getElementById('pt-press') as HTMLInputElement).value);
		const unit = (document.getElementById('pt-unit') as HTMLSelectElement).value;
		const phase = (document.getElementById('pt-phase') as HTMLSelectElement).value;
		const display = document.getElementById('pt-display');
		
		if (!display) return;
		if (isNaN(pressVal)) { display.innerHTML = '--- °C'; return; }
		
		if (ptTimer) clearTimeout(ptTimer);
		ptTimer = setTimeout(async () => {
			display.innerHTML = '<span class="animate-pulse text-white/50">...</span>';
			const t = await getDanfossTemp(ref, pressVal, unit, phase);
			if (t !== null) {
				display.innerHTML = `${t.toFixed(1)} °C`;
			} else {
				display.innerHTML = '<span class="text-danger">Err</span>';
			}
		}, 300);
	}

	// Superheat
	document.getElementById('btn-calc-diag')?.addEventListener('click', async () => {
		const mode = (document.querySelector('input[name="diag-mode"]:checked') as HTMLInputElement).value;
		const ref = (document.getElementById('diag-ref') as HTMLSelectElement).value;
		const press = parseFloat((document.getElementById('diag-press') as HTMLInputElement).value);
		const line = parseFloat((document.getElementById('diag-line') as HTMLInputElement).value);
		
		const resBox = document.getElementById('diag-result');
		const resText = document.getElementById('diag-result-text');

		if (isNaN(press) || isNaN(line)) {
			resBox?.classList.remove('hidden');
			if(resText) resText.innerHTML = `<div class="font-bold text-danger">${tr('შეავსეთ P და T!', 'Enter P and T.')}</div>`;
			return;
		}

		resBox?.classList.remove('hidden');
		if(resText) resText.innerHTML = `<div class="animate-pulse text-accent">${tr('იტვირთება Danfoss...', 'Loading Danfoss...')}</div>`;
		
		const phase = mode === 'sh' ? 'dew' : 'bubble';
		const satTemp = await getDanfossTemp(ref, press, 'bar', phase);
		
		if (satTemp === null) {
			if(resText) resText.innerHTML = `<div class="font-bold text-danger">${tr('API კავშირის შეცდომა.', 'API connection error.')}</div>`;
			return;
		}

		let diff = 0, title = '', expl = '', color = 'text-white';
		if (mode === 'sh') {
			diff = line - satTemp;
			title = 'SH';
			if (diff < 4) { expl = tr('დაბალია! სითხის დაბრუნების რისკი.', 'Low: risk of liquid refrigerant returning to the compressor.'); color = 'text-danger'; }
			else if (diff > 12) { expl = tr('მაღალია! ფრეონის ნაკლებობა.', 'High: possible refrigerant undercharge.'); color = 'text-fire'; }
			else { expl = tr('ნორმალურია.', 'Normal.'); color = 'text-green-400'; }
		} else {
			diff = satTemp - line;
			title = 'SC';
			if (diff < 2) { expl = tr('დაბალია! ფრეონის ნაკლებობა.', 'Low: possible refrigerant undercharge.'); color = 'text-fire'; }
			else if (diff > 10) { expl = tr('მაღალია! ფრეონის გადამეტება.', 'High: possible refrigerant overcharge.'); color = 'text-danger'; }
			else { expl = tr('ნორმალურია.', 'Normal.'); color = 'text-green-400'; }
		}

		if(resText) resText.innerHTML = `
			<div class="flex justify-between mb-1"><span class="text-white/50">Sat (Danfoss):</span> <strong>${satTemp.toFixed(1)} °C</strong></div>
			<div class="flex justify-between mb-2 pb-2 border-b border-white/10"><span class="text-white/50">${title}:</span> <strong class="text-[14px] text-accent">${diff.toFixed(1)} °C</strong></div>
			<div class="font-bold ${color}">${expl}</div>
		`;
	});

	// Airflow
	document.getElementById('btn-calc-air')?.addEventListener('click', () => {
		const btu = parseFloat((document.getElementById('air-btu') as HTMLInputElement).value);
		const ret = parseFloat((document.getElementById('air-return') as HTMLInputElement).value);
		const sup = parseFloat((document.getElementById('air-supply') as HTMLInputElement).value);
		
		const resBox = document.getElementById('air-result');
		const resText = document.getElementById('air-result-text');

		if (!btu || isNaN(ret) || isNaN(sup)) {
			resBox?.classList.remove('hidden');
			if(resText) resText.innerHTML = `<div class="font-bold text-danger">${tr('შეავსეთ t!', 'Enter t.')}</div>`;
			return;
		}
		
		const dt = ret - sup;
		if (dt <= 0) {
			resBox?.classList.remove('hidden');
		if(resText) resText.innerHTML = `<div class="font-bold text-danger">${tr('შეცდომა!', 'Error.')}</div>`;
			return;
		}

		let m3h = '---', msg = '', color = 'text-white';
		if (dt < 3) { msg = tr('კომპ. არ მუშაობს', 'Compressor may not be operating'); color = 'text-danger'; }
		else {
			const cfm = (btu * 0.75) / (1.08 * (dt * 1.8));
			m3h = Math.round(cfm * 1.7) + ' m³/h';
			if (dt < 8) { msg = tr('ცუდად აგრილებს', 'Cooling performance is low'); color = 'text-fire'; }
			else if (dt <= 15) { msg = tr('იდეალურია!', 'Within the expected range.'); color = 'text-green-400'; }
			else { msg = tr('ნაკადი შეზღუდულია!', 'Airflow may be restricted.'); color = 'text-danger'; }
		}

		resBox?.classList.remove('hidden');
		if(resText) resText.innerHTML = `
			<div class="flex justify-between mb-1"><span class="text-white/50">${tr('ნაკადი:', 'Airflow:')}</span> <strong class="text-accent">${m3h}</strong></div>
			<div class="flex justify-between mb-2 pb-2 border-b border-white/10"><span class="text-white/50">Delta T:</span> <strong>${dt.toFixed(1)} °C</strong></div>
			<div class="font-bold ${color}">${msg}</div>
		`;
	});

	// Converter
	document.getElementById('btn-calc-conv')?.addEventListener('click', () => {
		const v = parseFloat((document.getElementById('conv-input') as HTMLInputElement).value);
		const t = (document.getElementById('conv-type') as HTMLSelectElement).value;
		const d = document.getElementById('conv-result-display');
		if (!d) return;
		if (isNaN(v)) { d.innerHTML = '---'; return; }
		
		let r = 0, u = '';
		if (t === 'c_to_f') { r = (v * 9)/5 + 32; u = '°F'; }
		else if (t === 'f_to_c') { r = (v - 32)*5/9; u = '°C'; }
		else if (t === 'bar_to_psi') { r = v * 14.5038; u = 'PSI'; }
		else if (t === 'psi_to_bar') { r = v / 14.5038; u = 'Bar'; }
		else if (t === 'kw_to_btu') { r = v * 3412.14; u = 'BTU/h'; }
		else if (t === 'btu_to_kw') { r = v / 3412.14; u = 'kW'; }
		
		d.innerHTML = `${r.toFixed(2)} <span class="text-[10px] text-white/50">${u}</span>`;
	});
</script>



