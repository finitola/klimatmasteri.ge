---
import { getPageUrl, type Locale } from '../data/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

import { faqItemsByLocale, type FaqItem } from '../data/faq';

const faqItems: FaqItem[] = faqItemsByLocale[locale];
const text = locale === 'ka'
	? { section: 'ხშირად დასმული კითხვები', answer: 'პასუხის ნახვა', close: 'დახურვა', answerLabel: 'პასუხი:' }
	: { section: 'Frequently asked questions', answer: 'View answer', close: 'Close', answerLabel: 'Answer:' };
const faqStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${getPageUrl(locale, 'faq')}#faq`,
	mainEntity: faqItems.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.blocks.map((block) => block.type === 'paragraph' ? block.text : block.items.map((listItem) => `${listItem.label}${listItem.text}`).join(' ')).join(' '),
		},
	})),
};

---

<section class="mx-auto w-full max-w-shell px-5 py-10 sm:px-8 sm:py-12 lg:px-10 lg:py-14" aria-label={text.section}>
	<script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
	<div class="w-full">
		<div class="border-t border-white/10">
			{faqItems.map((item) => (
				<details class="group border-b border-white/10">
					<summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
						<span class="georgian-caps text-h4 font-bold leading-snug text-white transition-colors group-hover:text-fire group-open:text-fire">{item.question}</span>
						<span class="mt-0.5 flex shrink-0 items-center gap-2 text-small font-bold text-accent">
							<span class="group-open:hidden">{text.answer}</span>
							<span class="hidden group-open:inline">{text.close}</span>
							<svg class="size-5 transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
							</svg>
						</span>
					</summary>
					<div class="max-w-2xl pb-6 pr-8 text-base leading-7 text-white/75 sm:leading-8">
						<p class="mb-2 text-small font-extrabold uppercase tracking-[0.16em] text-accent">{text.answerLabel}</p>
						{item.blocks.map((block) => block.type === 'paragraph' ? (
							<p class="mt-3 first:mt-0">{block.text}</p>
						) : (
						<ul class="mt-3 grid gap-2 border-l-2 border-fire pl-5">
							{block.items.map((listItem) => (
								<li><strong class="font-bold text-white">{listItem.label}</strong>{listItem.text}</li>
							))}
						</ul>
						))}
					</div>
				</details>
			))}
		</div>
	</div>
</section>
