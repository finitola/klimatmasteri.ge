---
import {
	getPagePath,
	pageLabels,
	resourceNavigation,
	type Locale,
	type PageId,
} from '../data/site';
import BrandLogo from './BrandLogo.astro';
import { businessInfo } from '../data/business';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const currentYear = new Date().getFullYear();
const footerText = locale === 'ka'
	? {
		brand: 'პროფესიონალი კონდიციონერის ხელოსანი',
		intro: 'კლიმატ მასტერი გთავაზობთ კონდიციონერის პროფესიონალურ მომსახურებას, ჩვენ ვართ სერტიფიცირებული, მაღალი კვალიფიკაციის მქონე პროფესიონალები.',
		quickLinks: 'სწრაფი ბმულები',
		knowledge: 'გაიღრმავე ცოდნა',
		socials: 'სოციალური ქსელები',
		contact: 'კონტაქტი',
		address: 'თბილისი, საბურთალო',
		hours: 'სამუშაო 24/7',
		copyright: 'ყველა უფლება დაცულია',
	}
	: {
		brand: 'Air-conditioning technician',
		intro: 'Call KlimatMasteri for air-conditioning service from qualified, certified technicians.',
		quickLinks: 'Quick links',
		knowledge: 'Explore our guides',
		socials: 'Social media',
		contact: 'Contact',
		address: 'Tbilisi, Saburtalo',
		hours: 'Open 24/7',
		copyright: 'All rights reserved',
	};

const knowledgeLinks: PageId[] = [
	'learning',
	'air-conditioner-components',
	'air-conditioner-service',
	'air-conditioner-electrical',
];
const quickLinks: PageId[] = [...resourceNavigation.filter((id) => !knowledgeLinks.includes(id)), 'privacy', 'terms'];
const socialLinks = businessInfo.socialProfiles;
---

<footer class="border-t border-white/10 bg-night text-white">
	<div class="mx-auto max-w-shell px-5 sm:px-8 lg:px-10">
		<div class="grid gap-9 border-b border-white/10 py-10 sm:grid-cols-2 sm:py-12 md:grid-cols-3 md:gap-8 lg:gap-12 lg:py-14">
			<div class="max-w-md sm:col-span-2 md:col-span-1">
				<a
					class="inline-flex min-h-11 items-center rounded-lg font-brand text-2xl font-extrabold tracking-tight text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:text-3xl"
					href={getPagePath(locale, 'home')}
					aria-label={locale === 'ka' ? 'KlimatMasteri — მთავარი' : 'KlimatMasteri — home'}
				>
					<BrandLogo size="large" />
				</a>
				<p class="mt-2 text-sm font-semibold text-white/80">{footerText.brand}</p>
				<p class="mt-3 text-sm leading-7 text-white/65">{footerText.intro}</p>
				<nav class="mt-5" aria-label={footerText.socials}>
					<ul class="flex flex-wrap gap-2">
						{socialLinks.map((social) => (
							<li>
								<a class="flex size-10 items-center justify-center rounded-xl bg-night-panel text-white/70 transition-colors hover:bg-accent hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={social.href} target="_blank" rel="noopener noreferrer" aria-label={locale === 'ka' ? `${social.label} — ახალ ჩანართში გაიხსნება` : `${social.label} — opens in a new tab`} title={social.label}>
									<svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										{social.id === 'facebook' && <path d="M13.4 21v-8h2.7l.4-3.1h-3.1V8c0-.9.3-1.5 1.6-1.5h1.7V3.7c-.3 0-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5v1.8H7V13h2.7v8h3.7Z" />}
										{social.id === 'instagram' && <g>
											<rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
											<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
											<circle cx="17.6" cy="6.7" r="1.1" />
										</g>}
										{social.id === 'tiktok' && <path d="M15.8 3h-3.2v12.2a2.8 2.8 0 1 1-2.4-2.8v-3.3a6.1 6.1 0 1 0 5.6 6.1V9a8.2 8.2 0 0 0 4.6 1.4V7.2A5.1 5.1 0 0 1 15.8 3Z" />}
										{social.id === 'linkedin' && <path d="M5.2 8.5H2.4V21h2.8V8.5ZM3.8 3a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 0 0 0-3.4ZM21.6 13.8c0-3.8-2-5.6-4.7-5.6a4.1 4.1 0 0 0-3.7 2V8.5h-2.8V21h2.8v-6.2c0-1.6.3-3.2 2.3-3.2s2.1 1.9 2.1 3.3V21h2.8l1.2-7.2Z" />}
										{social.id === 'x' && <path d="M18.9 2.8h3.1l-6.8 7.8 8 10.6H17l-4.9-6.4-5.6 6.4H3.4l7.3-8.4L3 2.8h6.4l4.4 5.9 5.1-5.9Zm-1.1 16.5h1.7L8.3 4.6H6.5l11.3 14.7Z" />}
									</svg>
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>

			<div>
				<h2 class="georgian-caps text-h4 font-bold text-accent">{footerText.quickLinks}</h2>
				<nav aria-label={footerText.quickLinks}>
					<ul class="mt-4 grid gap-2">
						<li>
							<details class="group">
								<summary class="georgian-caps inline-flex min-h-8 w-fit cursor-pointer list-none items-center gap-2 text-sm font-semibold text-white/70 transition-colors hover:text-fire focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
									<span class="h-1.5 w-1.5 rounded-full bg-accent shrink-0 transition-all duration-300 group-hover:w-3 group-hover:bg-fire"></span>
									<span>{footerText.knowledge}</span>
									<svg class="size-4 shrink-0 text-accent transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</summary>
								<ul class="mt-2 grid gap-1 border-l border-white/15 pl-3">
									{knowledgeLinks.map((id) => (
										<li>
											<a class="georgian-caps group/sub inline-flex min-h-8 items-center gap-2 rounded-md text-sm text-white/65 transition-colors hover:text-fire focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={getPagePath(locale, id)}>
												<span class="h-1 w-1 rounded-full bg-accent/70 shrink-0 transition-all duration-300 group-hover/sub:w-2.5 group-hover/sub:bg-fire"></span>
												{pageLabels[id][locale]}
											</a>
										</li>
									))}
								</ul>
							</details>
						</li>
						{quickLinks.map((id) => (
							<li>
								<a class="georgian-caps group/link inline-flex min-h-8 items-center gap-2.5 rounded-md text-sm text-white/70 transition-colors hover:text-fire focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={getPagePath(locale, id)}>
									<span class="h-1.5 w-1.5 rounded-full bg-accent shrink-0 transition-all duration-300 group-hover/link:w-3 group-hover/link:bg-fire"></span>
									{pageLabels[id][locale]}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>

			<div>
				<h2 class="georgian-caps text-h4 font-bold text-accent">{footerText.contact}</h2>
				<ul class="mt-4 grid gap-4 text-sm text-white/70">
					<li class="flex items-start gap-3">
						<svg class="mt-0.5 size-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" stroke="currentColor" stroke-width="1.8" />
							<circle cx="12" cy="10" r="2.2" stroke="currentColor" stroke-width="1.8" />
						</svg>
						<address class="not-italic">{footerText.address}</address>
					</li>
					<li class="flex items-start gap-3">
						<svg class="mt-0.5 size-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M7.2 3.8h2.1l1.1 4.3-1.7 1.7a14.2 14.2 0 0 0 5.5 5.5l1.7-1.7 4.3 1.1v2.1c0 1-.8 1.8-1.8 1.8A15.6 15.6 0 0 1 5.4 5.6c0-1 .8-1.8 1.8-1.8Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						<a class="rounded-sm transition-colors hover:text-fire focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="tel:+995514128821">+995 514 12 88 21</a>
					</li>
					<li class="flex items-start gap-3">
						<svg class="mt-0.5 size-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8" />
							<path d="M12 7v5l3.2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						<span>{footerText.hours}</span>
					</li>
				</ul>
			</div>
		</div>

		<div class="flex min-h-16 items-center justify-between gap-6 py-4">
			<p class="text-left text-xs leading-6 text-white/60 sm:text-sm">© {currentYear} KlimatMasteri.ge <span class="px-1 text-white/25" aria-hidden="true">|</span> {footerText.copyright}</p>
			<!-- Reserved for future Google Tag Manager and analytics badges. -->
			<div class="hidden min-h-8 min-w-40 shrink-0 sm:block" aria-hidden="true"></div>
		</div>
	</div>
</footer>
