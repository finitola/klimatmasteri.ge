---
import type { Locale } from '../data/site';
import ContactActions from './ContactActions.astro';

interface Props {
	locale: Locale;
	prompt: string;
	eyebrow?: string;
}

const { locale, prompt, eyebrow } = Astro.props;
const text = locale === 'ka'
	? { eyebrow: 'დაგვიკავშირდი' }
	: { eyebrow: 'Contact us' };
---

<section class="border-y border-white/10 bg-[linear-gradient(110deg,#1e2428_0%,#15191c_65%,#20262a_100%)]">
	<div class="mx-auto flex max-w-shell flex-col gap-6 px-5 py-10 sm:px-8 sm:py-12 lg:flex-row lg:items-end lg:justify-between lg:px-10 lg:py-14">
		<div class="max-w-2xl">
			<p class="text-small font-extrabold uppercase tracking-[0.18em] text-accent">{eyebrow ?? text.eyebrow}</p>
			<h2 class="georgian-caps mt-3 text-h2 font-extrabold text-white">{prompt}</h2>
		</div>
		<ContactActions locale={locale} />
	</div>
</section>
