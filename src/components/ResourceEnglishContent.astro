---
import { getPagePath, type PageId } from '../data/site';
import { resourceEnglishPages } from '../data/resource-english';

interface Props {
	pageId: PageId;
}

const { pageId } = Astro.props;
const content = resourceEnglishPages[pageId];
const georgianLinkLabel = pageId === 'licensing-learning'
	? 'Open the Georgian exam questions and answers'
	: 'Open the Georgian practice test';
---

{content && (
	<article class="mx-auto w-full max-w-shell border-t border-white/10 px-5 py-10 sm:px-8 sm:py-14 lg:px-10 lg:py-16">
		<div class="grid gap-8 lg:grid-cols-[minmax(15rem,0.7fr)_minmax(0,1.3fr)] lg:gap-16">
			<div class="border-l-2 border-fire pl-5 sm:pl-7">
				<p class="text-small font-extrabold uppercase tracking-[0.16em] text-accent">English guide</p>
				<h2 class="mt-3 text-h2 font-extrabold text-white">Overview</h2>
			</div>
			<div>
				<p class="text-base font-medium leading-7 text-white/80 sm:text-lg sm:leading-8">{content.intro}</p>
				<div class="mt-8 divide-y divide-white/10 border-t border-white/10">
					{content.sections.map((section) => (
						<section class="py-5 first:pt-5">
							<h3 class="text-h4 font-extrabold text-fire">{section.title}</h3>
							<p class="mt-2 leading-7 text-white/75">{section.description}</p>
							{section.items && (
								<ul class="mt-3 grid gap-2 border-l-2 border-accent pl-5 text-white/80">
									{section.items.map((item) => <li>{item}</li>)}
								</ul>
							)}
							{section.links && (
								<ul class="mt-4 grid gap-2 sm:grid-cols-2">
									{section.links.map((link) => (
										<li><a class="inline-flex min-h-11 items-center text-sm font-bold text-accent underline decoration-accent/50 underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" href={getPagePath('en', link.pageId)}>{link.label}</a></li>
									))}
								</ul>
							)}
						</section>
					))}
				</div>
				{content.note && <aside class="mt-5 border-l-2 border-accent bg-night-panel px-5 py-4 text-sm leading-6 text-white/75">{content.note}</aside>}
				{content.georgianLink && (
					<a class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-bold text-accent underline decoration-accent/50 underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" href={getPagePath('ka', pageId)}>
						<span>{georgianLinkLabel}</span>
						<svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</a>
				)}
			</div>
		</div>
	</article>
)}
