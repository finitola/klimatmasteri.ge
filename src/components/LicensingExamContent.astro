---
// LicensingExamContent.astro
---

<div class="mx-auto max-w-shell px-5 py-10 sm:px-8 sm:py-12 lg:px-10 lg:py-14">
	<div class="mb-12 max-w-3xl">
		<p class="text-small font-extrabold uppercase tracking-[0.18em] text-accent mb-3">მომზადება და სერტიფიცირება</p>
		<h2 class="georgian-caps text-3xl font-bold text-white mb-6">მაცივარაგენტზე (ფრეონზე) მომუშავე სისტემების სალიცენზიო გამოცდა</h2>
		<p class="text-base leading-7 text-white/80 sm:text-lg sm:leading-8">
			საქართველოში მაცივარაგენტზე (ფრეონზე) მომუშავე სისტემებთან სამუშაოდ აუცილებელია შესაბამისი ლიცენზიის ქონა. 
			ეს სექცია დაგეხმარებათ გამოცდისთვის მომზადებაში, თეორიული ცოდნის მიღებასა და სიმულაციური ტესტირების გავლაში. აირჩიეთ სასურველი მოდული:
		</p>
	</div>

	<div class="grid gap-6 md:grid-cols-3">
		
		{/* 1. Learning (სწავლა) */}
		<a href="/macivaragentis-freonis-sagamocdo-kitxvebi-da-pasuxebi" class="group relative flex flex-col items-center p-10 rounded-3xl bg-blue-900/10 border border-white/10 shadow-lg hover:border-accent/50 hover:bg-blue-900/20 hover:shadow-accent/10 transition-all duration-300 transform hover:-translate-y-2">
			<div class="mb-6 flex h-24 w-24 items-center justify-center rounded-3xl bg-blue-900/40 text-accent group-hover:scale-110 transition-transform duration-500 group-hover:bg-accent group-hover:text-white group-hover:shadow-[0_0_30px_rgba(2,165,246,0.5)]">
				<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
				</svg>
			</div>
			<h3 class="text-2xl font-bold text-white mb-3 group-hover:text-accent transition-colors">სწავლა</h3>
			<p class="text-center text-sm text-white/60">კითხვები და პასუხები</p>
		</a>

		{/* 2. Testing (ტესტირება) */}
		<a href="/macivaragentis-freonis-gamocdis-simulaciuri-garemo" class="group relative flex flex-col items-center p-10 rounded-3xl bg-blue-900/10 border border-white/10 shadow-lg hover:border-fire/50 hover:bg-blue-900/20 hover:shadow-fire/10 transition-all duration-300 transform hover:-translate-y-2">
			<div class="mb-6 flex h-24 w-24 items-center justify-center rounded-3xl bg-orange-500/10 text-fire group-hover:scale-110 transition-transform duration-500 group-hover:bg-fire group-hover:text-white group-hover:shadow-[0_0_30px_rgba(255,191,0,0.5)]">
				<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
					<path d="M14 2v6h6"/>
					<path d="M16 13H8"/>
					<path d="M16 17H8"/>
					<path d="M10 9H8"/>
				</svg>
			</div>
			<h3 class="text-2xl font-bold text-white mb-3 group-hover:text-fire transition-colors">ტესტირება</h3>
			<p class="text-center text-sm text-white/60">სიმულაციური ტესტირება</p>
		</a>

		{/* 3. Information (ინფორმაცია) */}
		<a href="/macivaragentis-freonis-sagamocdo-testebis-dziritadi-sakitkhebi" class="group relative flex flex-col items-center p-10 rounded-3xl bg-blue-900/10 border border-white/10 shadow-lg hover:border-info/50 hover:bg-blue-900/20 hover:shadow-info/10 transition-all duration-300 transform hover:-translate-y-2">
			<div class="mb-6 flex h-24 w-24 items-center justify-center rounded-3xl bg-blue-500/10 text-info group-hover:scale-110 transition-transform duration-500 group-hover:bg-info group-hover:text-white group-hover:shadow-[0_0_30px_rgba(59,130,246,0.5)]">
				<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="10"/>
					<line x1="12" y1="16" x2="12" y2="12"/>
					<line x1="12" y1="8" x2="12.01" y2="8"/>
				</svg>
			</div>
			<h3 class="text-2xl font-bold text-white mb-3 group-hover:text-info transition-colors">ინფორმაცია</h3>
			<p class="text-center text-sm text-white/60">მაცივარაგენტები და წესები</p>
		</a>

	</div>
</div>
