---
import { Image } from 'astro:assets';
import aboutHeroImage from '../assets/images/chvens-shesaxeb-kondicioneris-xelosani.webp';
import contactHeroImage from '../assets/images/sakontaqto-kondicioneris-xelosani.png';
import faqHeroImage from '../assets/images/kitxvebi-kondicioneris-konsultacia.png';
import homeHeroImage from '../assets/images/kondicioneris-xelosani.webp';
import acComponentsHeroImage from '../assets/images/kondicioneris-komponentebi.jpg';
import acElectricalHeroImage from '../assets/images/kondicioneris-eleqtrooba.jpg';
import hvacSystemsHeroImage from '../assets/images/kondicirebis-sistemebi.jpg';
import refrigerantsHeroImage from '../assets/images/macivareagentebi.jpg';
import calculatorsHeroImage from '../assets/images/kondicioneris-kalkulatori.jpg';
import licensingHeroImage from '../assets/images/licenziis-gamocda.jpg';
import simulationHeroImage from '../assets/images/licenziis-simulacia.jpg';
import repairHeroImage from '../assets/images/kondicioneris-sheketeba.jpg';
import servicesHeroImage from '../assets/images/kondicioneris-montaji.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import AirConditionerComponentsContent from './AirConditionerComponentsContent.astro';
import AirConditionerElectricalContent from './AirConditionerElectricalContent.astro';
import AirConditionerRepairContent from './AirConditionerRepairContent.astro';
import ContactActions from './ContactActions.astro';
import ContactPageContent from './ContactPageContent.astro';
import FaqContent from './FaqContent.astro';
import HomeSystemsSection from './HomeSystemsSection.astro';
import HvacSystemsContent from './HvacSystemsContent.astro';
import LicensingExamContent from './LicensingExamContent.astro';
import LicensingInfoContent from './LicensingInfoContent.astro';
import LicensingQuestionsContent from './LicensingQuestionsContent.astro';
import LicensingTestingContent from './LicensingTestingContent.astro';
import RefrigerantsContent from './RefrigerantsContent.astro';
import CalculatorsContent from './CalculatorsContent.astro';
import RelatedPages from './RelatedPages.astro';
import ServiceContactCta from './ServiceContactCta.astro';
import ServiceDetailContent from './ServiceDetailContent.astro';
import ResourceEnglishContent from './ResourceEnglishContent.astro';
import WorksGallery from './WorksGallery.astro';
import { getPagePath, pageLabels, pages, servicePageIds, resourceNavigation, type Locale, type PageId } from '../data/site';
import { serviceDetails, type ServicePageId } from '../data/service-details';
import { resourceEnglishPages } from '../data/resource-english';
import { getBreadcrumbs } from '../data/seo';
import { getPageHeroAlt, homeHeroAlt } from '../data/image-alt';

interface Props {
	locale: Locale;
	pageId: PageId;
}

const { locale, pageId } = Astro.props;
const page = pages[pageId];
const isHome = pageId === 'home';
const isServicesPage = pageId === 'services';
const isAboutPage = pageId === 'about';
const isPrivacyPage = pageId === 'privacy';
const isTermsPage = pageId === 'terms';
const isFaqPage = pageId === 'faq';
const isWorksPage = pageId === 'works';
const isContactPage = pageId === 'contact';
const isRepairPage = pageId === 'air-conditioner-service';
const isLearningPage = pageId === 'learning';
const isComponentsPage = pageId === 'air-conditioner-components';
const isElectricalPage = pageId === 'air-conditioner-electrical';
const isRefrigerantsPage = pageId === 'refrigerants';
const isLicensingPage = pageId === 'licensing';
const isLicensingLearningPage = pageId === 'licensing-learning';
const isLicensingTestingPage = pageId === 'licensing-testing';
const isLicensingInfoPage = pageId === 'licensing-info';
const isCalculatorsPage = pageId === 'calculators';
const isAnyLicensingPage = isLicensingPage || isLicensingLearningPage || isLicensingTestingPage || isLicensingInfoPage;
const hasPhotoHero = isAboutPage || isServicesPage || isFaqPage || isContactPage || isRepairPage || isLearningPage || isComponentsPage || isElectricalPage || isRefrigerantsPage || isAnyLicensingPage || isCalculatorsPage;
const pageHeroImage = isAboutPage ? aboutHeroImage : isServicesPage ? servicesHeroImage : isContactPage ? contactHeroImage : isRepairPage ? repairHeroImage : isLearningPage ? hvacSystemsHeroImage : isComponentsPage ? acComponentsHeroImage : isElectricalPage ? acElectricalHeroImage : isRefrigerantsPage ? refrigerantsHeroImage : isCalculatorsPage ? calculatorsHeroImage : isLicensingTestingPage ? simulationHeroImage : isAnyLicensingPage ? licensingHeroImage : faqHeroImage;
const isServiceDetail = servicePageIds.includes(pageId);
const breadcrumbs = getBreadcrumbs(locale, pageId);
const visibleBreadcrumbs = isServiceDetail ? breadcrumbs.slice(0, -1) : breadcrumbs;

const servicesIntro = locale === 'ka'
	? 'რა სერვისებს გთავაზობთ კლიმატ მასტერი ? '
	: 'What services does KlimatMasteri offer?';
const servicesHeroIntro = locale === 'ka'
	? 'კონდიციოენრის სერვისების გვერდზე, დეტალურად გაეცნობით ინფორმაციას თითოეულ სერვისზე, რასაც კლიმატ მასტერი გთავაზობთ.'
	: 'On the air-conditioning services page, you can find detailed information about every service offered by KlimatMasteri.';
const homeServices = locale === 'ka' ? [
	'კონდიციონერის მონტაჟი',
	'კონდიციონერის დემონტაჟი',
	'კონდიციონერის დიაგნოსტიკა',
	'კონდიციონერიდან წყლის წვეთის პრობლემის მოგვარება',
	'კონდიციონერის ფილტრების გაწმენდა',
	'კონდიციონერის შეკეთება',
	'კონდიციონერის ჟონვის პოვნა და შეკეთება',
	'კონდიციონერის შიდა და გარე ბლოკების ღრმა წმენდა',
	'კონდიციონერზე მაცივარაგენტის (ფრეონის) დონის შემოწმება, ფრეონის ჩასხმა.',
	'კონდიციონერის მილების დაგრძელება',
	'კონდიციონერის მილების წინასწარი მონტაჟი',
	'კონდიციონერის სადრენაჟე სისტემის მოწყობა, პომპის ინტეგრაცია (ინსტალაცია)',
	'კონდიციონერის დაზიანებული ნაწილის შეცვლა',
	'კონდიციონერის პლატის შეკეთება/შეცვლა.',
]: [
	'Air conditioner installation',
	'Air conditioner dismantling',
	'Air conditioner diagnostics',
	'Air conditioner water leak repair',
	'Air conditioner filter cleaning',
	'Air conditioner repair',
	'Air conditioner leak detection and repair',
	'Deep cleaning of indoor and outdoor air-conditioner units',
	'Air conditioner refrigerant level check and refill',
	'Air conditioner pipe extension',
	'Pre-installation of air-conditioner piping',
	'Air conditioner drainage system setup and pump installation',
	'Replacement of damaged air-conditioner parts',
	'Air conditioner control board repair or replacement',
];
const text = locale === 'ka'
	? {
		placeholder: 'გვერდის შინაარსი დაემატება შემდეგ ეტაპზე.',
		homeTitle: 'კონდიციონერის ხელოსანი',
		repair: 'კონდიციონერის შეკეთება',
		installation: 'კონდიციონერის მონტაჟი',
		description: 'გამოიძახე კლიმატ მასტერი და მიიღე პროფესიონალური მომსახურება.',
		call: 'გამოიძახე ხელოსანი',
		learnMore: 'დაწვრილებით ნახვა',
		questionsCta: 'ვერ იპოვე კითხვაზე პასუხი?',
		serviceCta: 'გჭირდება რომელიმე სერვისი?',
		aboutCta: 'გინდა მიიღო ხარისხიანი მომსახუება ?',
		contactCta: 'გჭირდება კონდიციონერის ხელოსანი ?',
	}
	: {
		placeholder: 'Page content will be added in a later stage.',
		homeTitle: 'Air Conditioner Technician',
		repair: 'Air Conditioner Repair',
		installation: 'Air Conditioner Installation',
		description: 'Call KlimatMasteri for professional service from qualified and certified air conditioner technicians.',
		call: 'Call a technician',
		learnMore: 'View details',
		questionsCta: 'Could not find the answer you need?',
		serviceCta: 'Need this service?',
		aboutCta: 'Would you like to receive quality service?',
		contactCta: 'Need an air conditioner technician?',
	};

let relatedIds: PageId[] = [];
if (isLicensingLearningPage) {
	relatedIds = ['licensing-testing', 'licensing-info'];
} else if (isLicensingTestingPage) {
	relatedIds = ['licensing-learning', 'licensing-info'];
} else if (isLicensingInfoPage) {
	relatedIds = ['licensing-learning', 'licensing-testing'];
} else if (isServiceDetail) {
	const currentIdx = servicePageIds.indexOf(pageId);
	relatedIds = [
		servicePageIds[(currentIdx + 1) % servicePageIds.length],
		servicePageIds[(currentIdx + 2) % servicePageIds.length],
		servicePageIds[(currentIdx + 3) % servicePageIds.length],
	];
}
---

<BaseLayout locale={locale} pageId={pageId}>
	<main id="main-content" class="w-full flex-1 bg-night text-white">
		{isHome ? (
			<>
				<section class="relative isolate min-h-168 overflow-hidden border-b border-white/10 bg-night sm:min-h-176 lg:min-h-160">
					<div class="absolute inset-0 lg:inset-y-0 lg:left-[34%] lg:right-0">
						<Image class="size-full object-cover object-[68%_center]" src={homeHeroImage} widths={[480, 768, 1024, 1280, 1440, 1721]} sizes="(min-width: 64rem) 66vw, 100vw" format="webp" quality={82} alt={homeHeroAlt[locale]} priority />
						<div class="absolute inset-0 bg-night/75 backdrop-blur-[2px] lg:bg-linear-to-r lg:from-night lg:via-night/85 lg:to-night/10 lg:backdrop-blur-0"></div>
					</div>
					<div class="relative mx-auto flex min-h-168 max-w-shell items-center px-5 py-8 sm:min-h-176 sm:px-8 sm:py-12 lg:min-h-160 lg:px-10 lg:py-16">
						<div class="max-w-2xl">
							<h1 class="georgian-caps text-h1 font-extrabold tracking-tight text-white">{text.homeTitle}</h1>
							<div class="mt-5 grid gap-3 sm:grid-cols-2 sm:gap-5 lg:mt-7 lg:max-w-2xl">
								<h2 class="georgian-caps min-w-0 border-l-2 border-accent pl-4 text-lg font-bold leading-snug text-white sm:text-xl">{text.repair}</h2>
								<h2 class="georgian-caps min-w-0 border-l-2 border-fire pl-4 text-lg font-bold leading-snug text-white sm:text-xl">{text.installation}</h2>
							</div>
							<h3 class="mt-5 max-w-xl text-base font-medium leading-7 text-white/75 sm:text-lg sm:leading-8">{text.description}</h3>
							<a class="mt-4 flex min-h-11 w-fit items-center gap-3 rounded-md font-brand text-base font-extrabold tabular-nums text-white transition-colors hover:text-fire focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:text-lg" href="tel:+995514128821" aria-label={locale === 'ka' ? 'დაგვირეკე: +995 514 12 88 21' : 'Call us: +995 514 12 88 21'}>
								<svg class="size-5 text-fire" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path d="M7.2 3.8h2.1l1.1 4.3-1.7 1.7a14.2 14.2 0 0 0 5.5 5.5l1.7-1.7 4.3 1.1v2.1c0 1-.8 1.8-1.8 1.8A15.6 15.6 0 0 1 5.4 5.6c0-1 .8-1.8 1.8-1.8Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								<span>+995 514 12 88 21</span>
							</a>
							<a class="mt-3 flex min-h-12 w-fit items-center gap-3 rounded-full border border-white/25 px-5 text-sm font-bold text-white transition-colors hover:border-accent hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" href={getPagePath(locale, 'services')}>
								<span>{pageLabels.services[locale]}</span>
								<svg class="size-4 text-fire" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
						</div>
					</div>
				</section>

				<section class="border-b border-white/10 bg-night-panel" aria-label={locale === 'ka' ? 'საკონტაქტო ინფორმაცია' : 'Contact information'}>
					<div class="mx-auto grid max-w-shell divide-y divide-white/10 px-5 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-8 lg:px-10">
						<div class="flex flex-col items-center py-4 text-center sm:px-5 sm:py-5 lg:px-8">
							<p class="text-small font-bold uppercase tracking-[0.16em] text-accent">{locale === 'ka' ? 'მისამართი' : 'Location'}</p>
							<p class="mt-1 text-sm font-semibold text-white">{locale === 'ka' ? 'თბილისი, საბურთალო' : 'Tbilisi, Saburtalo'}</p>
						</div>
						<div class="flex flex-col items-center py-4 text-center sm:px-5 sm:py-5 lg:px-8">
							<p class="text-small font-bold uppercase tracking-[0.16em] text-accent">{locale === 'ka' ? 'ტელეფონი' : 'Phone'}</p>
							<a class="mt-1 inline-flex rounded-sm text-sm font-bold tabular-nums text-white hover:text-fire focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="tel:+995514128821">+995 514 12 88 21</a>
						</div>
						<div class="flex flex-col items-center py-4 text-center sm:px-5 sm:py-5 lg:px-8">
							<p class="text-small font-bold uppercase tracking-[0.16em] text-accent">{locale === 'ka' ? 'სამუშაო დრო' : 'Hours'}</p>
							<p class="mt-1 text-sm font-semibold text-white">{locale === 'ka' ? 'სამუშაო 24/7' : 'Open 24/7'}</p>
						</div>
					</div>
				</section>

				<section id="services" class="mx-auto max-w-shell px-5 py-12 sm:px-8 sm:py-16 lg:px-10 lg:py-20">
						<div class="max-w-2xl">
							<h2 class="georgian-caps text-h2 font-extrabold text-white">{pageLabels.services[locale]}</h2>
							<p class="mt-3 text-base leading-7 text-white/65 sm:leading-8">{servicesIntro}</p>
						</div>
						<ol data-home-services-list class="mt-8 grid gap-2 sm:mt-10" aria-label={locale === 'ka' ? 'კონდიციონერის მომსახურებები' : 'Air conditioner services'}>
							{homeServices.map((service, index) => (
								<li data-home-service-item>
										<details name="home-services" open={index === 0} data-home-service class="group overflow-hidden rounded-md border border-white/10 bg-white/[0.025] transition-colors duration-300 open:border-accent/45 open:bg-night-panel">
										<summary class="flex cursor-pointer list-none items-center gap-3 px-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden sm:gap-5 sm:px-5">
											<span data-home-service-number class:list={[
												'font-brand text-small font-extrabold tabular-nums tracking-wider',
												index % 2 === 0 ? 'text-accent' : 'text-fire',
											]}>{String(index + 1).padStart(2, '0')}</span>
											<h3 data-home-service-label class="georgian-caps min-w-0 flex-1 text-left text-sm font-bold leading-6 text-white sm:text-base">{service}</h3>
										</summary>
										<div data-home-service-content class="px-4 py-2 sm:px-5 sm:py-0">
											<div class="sm:ml-10">
												{locale === 'ka' ? (
													<>
														<a class="w-fit rounded-sm font-brand text-lg font-extrabold tabular-nums text-fire underline decoration-transparent underline-offset-4 transition-colors hover:text-white hover:decoration-fire focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="tel:+995514128821">514-12-88-21</a>
														<p class="mt-3 text-sm font-semibold leading-6 text-white/90">KlimatMasteri. | კონდიციონერის ხელოსანი - მაღალი სტანდარტები, პროფესიონალიზმი, პასუხისმგებლობა.</p>
														<div class="mt-auto w-full pt-5 text-left">
															<p class="text-left text-sm font-bold leading-6 text-white/80">რა სერვისებს გთავაზობთ ?</p>
															<a class="mt-7 flex min-h-11 w-fit items-center justify-center rounded-md bg-accent px-5 text-sm font-bold text-ink shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-fire hover:shadow-button active:translate-y-0 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" href={getPagePath(locale, 'services')}>სერვისების ნახვას</a>
														</div>
													</>
												) : (
													<>
														<p class="text-base font-semibold leading-7 text-white/90 sm:text-lg sm:leading-8">If you need another service, click</p>
														<a class="mt-auto inline-flex min-h-11 w-full items-center justify-center rounded-md bg-accent px-5 text-sm font-bold text-ink shadow-button transition-all duration-200 hover:-translate-y-0.5 hover:bg-fire hover:shadow-button active:translate-y-0 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" href={getPagePath(locale, 'services')}>view services</a>
													</>
												)}
											</div>
										</div>
									</details>
								</li>
							))}
						</ol>
				</section>

				<HomeSystemsSection locale={locale} />

				<section class="border-y border-white/10 bg-[linear-gradient(110deg,#1e2428_0%,#15191c_65%,#20262a_100%)]">
					<div class="mx-auto flex max-w-shell flex-col gap-6 px-5 py-10 sm:px-8 sm:py-12 lg:flex-row lg:items-end lg:justify-between lg:px-10 lg:py-14">
						<div>
							<p class="text-small font-extrabold uppercase tracking-[0.18em] text-accent">{locale === 'ka' ? 'პრობლემის მოსაგვარებლად' : pageLabels.contact[locale]}</p>
							<h2 class="georgian-caps mt-3 text-h2 font-extrabold text-white">{locale === 'ka' ? 'გამოიძახე კონდიციონერის ხელოსანი' : text.call}</h2>
						</div>
						<div class="flex w-full justify-start lg:w-auto lg:justify-end">
							<ContactActions locale={locale} />
						</div>
					</div>
				</section>

				<section class="border-t border-white/10 bg-night" aria-labelledby="home-statistics-title">
						<div class="mx-auto max-w-shell px-5 py-10 sm:px-8 sm:py-12 lg:px-10 lg:py-14">
							<h2 id="home-statistics-title" class="georgian-caps text-h2 font-extrabold text-white">{locale === 'ka' ? 'ჩვენი გამოცდილება' : 'Our experience'}</h2>
							<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-4" data-statistics>
								<div class="flex min-h-36 flex-col items-center justify-center border border-white/10 bg-night-panel px-4 py-6 text-center sm:min-h-40">
									<p class="font-brand text-4xl font-extrabold leading-none tabular-nums text-accent sm:text-5xl"><span data-count="750" aria-hidden="true">0</span><span aria-hidden="true">+</span><span class="sr-only">{locale === 'ka' ? '750-ზე მეტი' : 'More than 750'}</span></p>
									<p class="georgian-caps mt-4 text-base font-bold text-white/80">{locale === 'ka' ? 'კონდიციონერის მონტაჟი' : 'Air conditioner installations'}</p>
								</div>
								<div class="flex min-h-36 flex-col items-center justify-center border border-white/10 bg-night-panel px-4 py-6 text-center sm:min-h-40">
									<p class="font-brand text-4xl font-extrabold leading-none tabular-nums text-fire sm:text-5xl"><span data-count="750" aria-hidden="true">0</span><span aria-hidden="true">+</span><span class="sr-only">{locale === 'ka' ? '750-ზე მეტი' : 'More than 750'}</span></p>
									<p class="georgian-caps mt-4 text-base font-bold text-white/80">{locale === 'ka' ? 'კონდიციონერის შეკეთება' : 'Air conditioner repairs'}</p>
								</div>
								<div class="flex min-h-36 flex-col items-center justify-center border border-white/10 bg-night-panel px-4 py-6 text-center sm:min-h-40">
									<p class="font-brand text-4xl font-extrabold leading-none tabular-nums text-accent sm:text-5xl"><span data-count="1500" aria-hidden="true">0</span><span aria-hidden="true">+</span><span class="sr-only">{locale === 'ka' ? '1500-ზე მეტი' : 'More than 1,500'}</span></p>
									<p class="georgian-caps mt-4 text-base font-bold text-white/80">{locale === 'ka' ? 'კმაყოფილი მომხმარებელი' : 'Satisfied customers'}</p>
								</div>
							</div>
						</div>
				</section>
			</>
		) : (
			<>
