---
import type { Locale } from '../data/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

if (locale !== 'ka') {
	return null; // English content not provided yet
}
---

<div class="mx-auto w-full max-w-shell px-5 py-10 sm:px-8 sm:py-12 lg:px-10 lg:py-14">
	<!-- Hero / Intro Card -->
	<div class="mb-12 rounded-2xl border border-white/10 bg-blue-900/10 p-6 shadow-lg md:p-8">
		<h3 class="mb-3 text-xl font-bold text-accent md:text-2xl">ზოგადი ინფორმაცია</h3>
		<p class="text-base leading-relaxed text-white/80 sm:text-lg">
			აქ მოცემული ინფორმაცია აღებულია ტესტებიდან (206 კითხვა) და განკუთვნილია
			ინფორმაციის მარტივად მოსაძიებლად და დასამახსოვრებლად.
		</p>
	</div>

	<aside class="mb-12 flex flex-col gap-3 rounded-2xl border border-accent/25 bg-blue-900/10 p-6 sm:flex-row sm:items-center sm:justify-between md:p-8">
		<p class="text-base leading-relaxed text-white/80 sm:text-lg">
			სერტიფიკატის ასაღებად საჭირო დეტალური ინფორმაციის გასაცნობად გადადით სამინისტროს ოფიციალურ გვერდზე.
		</p>
		<a
			href="https://www.eiec.gov.ge/ka/programs/certificate-courses/refrigerant-equipment-certification"
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex min-h-11 shrink-0 items-center gap-2 self-start text-sm font-bold text-accent underline decoration-accent/50 underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:self-auto"
		>
			<span>სამინისტროს ოფიციალური გვერდი</span>
			<svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M14 4h6v6m-11 4L20 4M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</a>
	</aside>

	<div class="space-y-12">
		<!-- 1. Classification -->
		<div class="rounded-2xl border border-white/10 bg-blue-900/10 p-6 shadow-lg md:p-8">
			<h2 class="mb-6 flex items-center gap-3 text-2xl font-bold text-white">
				<span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-accent text-sm text-night-panel">1</span>
				მაცივარაგენტების კლასიფიკაცია
			</h2>
			<div class="mb-8 overflow-hidden rounded-xl border border-white/20">
				<div class="overflow-x-auto">
					<table class="w-full min-w-[600px] text-left text-sm text-white/80">
						<thead>
							<tr class="bg-blue-900/30">
								<th class="border-b border-white/20 p-4 font-semibold text-white">ჯგუფი</th>
								<th class="border-b border-white/20 p-4 font-semibold text-white">განმარტება</th>
								<th class="border-b border-white/20 p-4 font-semibold text-white">მაგალითები</th>
								<th class="border-b border-white/20 p-4 font-semibold text-white">ODP (ოზონი)</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-white/10">
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4"><span class="inline-flex rounded-md bg-white/10 px-2 py-1 text-xs font-semibold text-white">ქფნ (CFC)</span></td>
								<td class="p-4">ქლორფტორნახშირბადები</td>
								<td class="p-4">R12</td>
								<td class="p-4 font-bold text-fire">მაღალი</td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4"><span class="inline-flex rounded-md bg-white/10 px-2 py-1 text-xs font-semibold text-white">წქფნ (HCFC)</span></td>
								<td class="p-4">წყალბადქლორფტორნახშირბადები</td>
								<td class="p-4">R22</td>
								<td class="p-4 font-bold text-fire">საშუალო</td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4"><span class="inline-flex rounded-md bg-white/10 px-2 py-1 text-xs font-semibold text-white">წფნ (HFC)</span></td>
								<td class="p-4">წყალბადფტორნახშირბადები</td>
								<td class="p-4">R134a, R410A</td>
								<td class="p-4">ნულოვანი</td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4"><span class="inline-flex rounded-md bg-white/10 px-2 py-1 text-xs font-semibold text-white">HC</span></td>
								<td class="p-4">ბუნებრივი აირები</td>
								<td class="p-4">R600a, R290</td>
								<td class="p-4">ნულოვანი</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>

			<h3 class="mb-4 text-xl font-bold text-white">უსაფრთხოების ჯგუფები</h3>
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
				<div class="rounded-xl border border-green-500/30 bg-blue-900/20 p-5">
					<span class="mb-3 inline-flex rounded-md bg-green-500/20 px-2 py-1 text-xs font-bold text-green-400">A1</span>
					<p class="text-sm text-white/80 leading-relaxed">
						<strong class="text-white block mb-1">არატოქსიკური, არააალებადი</strong>
						R22, R134a, R410A, R744
					</p>
				</div>
				<div class="rounded-xl border border-yellow-500/30 bg-blue-900/20 p-5">
					<span class="mb-3 inline-flex rounded-md bg-yellow-500/20 px-2 py-1 text-xs font-bold text-yellow-400">A2L</span>
					<p class="text-sm text-white/80 leading-relaxed">
						<strong class="text-white block mb-1">დაბალი აალებადობა</strong>
						R1234yf
					</p>
				</div>
				<div class="rounded-xl border border-red-500/30 bg-blue-900/20 p-5">
					<span class="mb-3 inline-flex rounded-md bg-red-500/20 px-2 py-1 text-xs font-bold text-red-400">A3</span>
					<p class="text-sm text-white/80 leading-relaxed">
						<strong class="text-white block mb-1">მაღალი აალებადობა</strong>
						R600a, R290
					</p>
				</div>
				<div class="rounded-xl border border-blue-500/30 bg-blue-900/20 p-5">
					<span class="mb-3 inline-flex rounded-md bg-blue-500/20 px-2 py-1 text-xs font-bold text-blue-400">B2</span>
					<p class="text-sm text-white/80 leading-relaxed">
						<strong class="text-white block mb-1">ტოქსიკური, აალებადი</strong>
						R717 (ამიაკი)
					</p>
				</div>
			</div>
		</div>

		<!-- 2. Legislation -->
		<div class="rounded-2xl border border-white/10 bg-blue-900/10 p-6 shadow-lg md:p-8">
			<h2 class="mb-6 flex items-center gap-3 text-2xl font-bold text-white">
				<span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-accent text-sm text-night-panel">2</span>
				ჯარიმები და კანონმდებლობა
			</h2>
			<div class="mb-6 overflow-hidden rounded-xl border border-white/20">
				<div class="overflow-x-auto">
					<table class="w-full min-w-[600px] text-left text-sm text-white/80">
						<thead>
							<tr class="bg-blue-900/30">
								<th class="border-b border-white/20 p-4 font-semibold text-white">დარღვევის ტიპი</th>
								<th class="border-b border-white/20 p-4 font-semibold text-white">ჯარიმა (ლარი)</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-white/10">
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">ელექტრონული სისტემის წარმოების წესის დარღვევა</td>
								<td class="p-4 font-bold text-fire">500 ₾</td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">ტექნიკური რეგლამენტის ზოგადი დარღვევა</td>
								<td class="p-4 font-bold text-fire">1000 ₾</td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">არასერტიფიცირებული პირი (მომსახურება)</td>
								<td class="p-4">ფიზიკური: <strong class="text-white">400</strong> / იურიდიული: <strong class="text-white">1000</strong></td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">განმეორებითი დარღვევა</td>
								<td class="p-4">ფიზიკური: <strong class="text-white">800</strong> / იურიდიული: <strong class="text-white">2000</strong></td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">ნივთიერების უკანონო შეძენა/გასხვისება</td>
								<td class="p-4"><strong class="text-white">150 ₾</strong> (თითო კილოგრამზე)</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			<ul class="space-y-2 pl-5 text-sm text-white/80 list-disc marker:text-accent">
				<li><strong class="text-white">R22 შეზღუდვა:</strong> სრულად იკრძალება 2040 წელს.</li>
				<li><strong class="text-white">კიგალის დანართი:</strong> არეგულირებს HFC-ების შემცირებას.</li>
				<li><strong class="text-white">სერტიფიკატი:</strong> გაიცემა 5 წლის ვადით.</li>
			</ul>
		</div>

		<!-- 3. Maintenance Intervals -->
		<div class="rounded-2xl border border-white/10 bg-blue-900/10 p-6 shadow-lg md:p-8">
			<h2 class="mb-4 flex items-center gap-3 text-2xl font-bold text-white">
				<span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-accent text-sm text-night-panel">3</span>
				ტექნიკური მომსახურების ინტერვალები
			</h2>
			<p class="mb-6 text-sm text-white/60">საგამოცდო ტესტებში მოცემული პერიოდულობა და ვადები:</p>
			<div class="mb-4 overflow-hidden rounded-xl border border-white/20">
				<div class="overflow-x-auto">
					<table class="w-full min-w-[600px] text-left text-sm text-white/80">
						<thead>
							<tr class="bg-blue-900/30">
								<th class="border-b border-white/20 p-4 font-semibold text-white">მოთხოვნა</th>
								<th class="border-b border-white/20 p-4 font-semibold text-white">ვადა / სიხშირე</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-white/10">
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">გაჟონვაზე გეგმური შემოწმება (3 კგ და მეტი კონტროლირებადი მაცივარაგენტი)</td>
								<td class="p-4"><span class="inline-flex rounded-md bg-green-500/20 px-2 py-1 text-xs font-bold text-green-400">სულ მცირე, 12 თვეში ერთხელ</span></td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">ფტორირებული მაცივარაგენტის სტაციონარული დეტექტორის დაკალიბრება</td>
								<td class="p-4"><span class="inline-flex rounded-md bg-green-500/20 px-2 py-1 text-xs font-bold text-green-400">12 თვეში ერთხელ</span></td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">ტექნიკოსის სერტიფიკატის მოქმედების ვადა</td>
								<td class="p-4"><span class="inline-flex rounded-md bg-accent/15 px-2 py-1 text-xs font-bold text-accent">5 წელი</span></td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">ტექნიკოსის მინიმალური სტაჟირება დამოუკიდებლად მუშაობისთვის</td>
								<td class="p-4"><span class="inline-flex rounded-md bg-accent/15 px-2 py-1 text-xs font-bold text-accent">1 თვე</span></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			
			<div class="flex items-start gap-3 rounded-xl bg-blue-900/30 p-4 border border-accent/20 text-sm text-white/70">
				<svg class="size-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
				<p><em>შენიშვნა: სარეგისტრაციო ჟურნალის წარმოება სავალდებულოა სტაციონარულ მოწყობილობაზე, რომელიც შეიცავს მინიმუმ 3 კგ (3 კგ და მეტ) მაცივარაგენტს.</em></p>
			</div>
		</div>

		<!-- 4. Safety Norms -->
		<div class="rounded-2xl border border-white/10 bg-blue-900/10 p-6 shadow-lg md:p-8">
			<h2 class="mb-6 flex items-center gap-3 text-2xl font-bold text-white">
				<span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-accent text-sm text-night-panel">4</span>
				უსაფრთხოების ნორმები და ზღვრები
			</h2>
			<div class="mb-6 overflow-hidden rounded-xl border border-white/20">
				<div class="overflow-x-auto">
					<table class="w-full min-w-[600px] text-left text-sm text-white/80">
						<thead>
							<tr class="bg-blue-900/30">
								<th class="border-b border-white/20 p-4 font-semibold text-white">მაცივარაგენტი</th>
								<th class="border-b border-white/20 p-4 font-semibold text-white">პრაქტიკული ნორმა (კგ/მ³)</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-white/10">
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">R134a</td>
								<td class="p-4">0.25</td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">R744 (CO₂)</td>
								<td class="p-4">0.07</td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">R290 (პროპანი)</td>
								<td class="p-4">0.008</td>
							</tr>
							<tr class="transition-colors hover:bg-white/5">
								<td class="p-4">R717 (ამიაკი)</td>
								<td class="p-4">0.00035</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			<ul class="space-y-2 pl-5 text-sm text-white/80 list-disc marker:text-accent">
				<li><strong class="text-white">ვენტილაცია:</strong> მინიმუმ 4-ჯერადი ცვლა საათში.</li>
				<li><strong class="text-white">ცხელი ზედაპირი:</strong> სხვაობა თვითაალების ტემპერატურამდე მინიმუმ 150°C.</li>
				<li><strong class="text-white">ბალონის შევსება:</strong> უსაფრთხო ნორმაა 80%.</li>
				<li><strong class="text-white">დეტექტორი (A2/A3):</strong> განგაში LFL-ის 20%-ზე.</li>
			</ul>
		</div>

		<!-- 5. Best Practices -->
		<div class="rounded-2xl border border-fire/30 bg-blue-900/10 p-6 shadow-lg shadow-fire/5 md:p-8 relative overflow-hidden">
			<div class="absolute left-0 top-0 h-full w-1.5 bg-fire"></div>
			<h2 class="mb-6 flex items-center gap-3 text-2xl font-bold text-white">
				<span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-fire text-sm text-night-panel">5</span>
				<span class="text-fire">ტექნიკური რჩევები (Best Practices)</span>
			</h2>
			<ul class="space-y-3 pl-5 text-sm text-white/80 list-disc marker:text-fire">
				<li><strong class="text-white">ვაკუუმირება:</strong> გარემოს ტემპერატურაზე ტენის აორთქლებისათვის საკმარისი ვაკუუმის შექმნა.</li>
				<li><strong class="text-white">ჰერმეტულობის ტესტი:</strong> გამოიყენება მშრალი აზოტი.</li>
				<li><strong class="text-white">ზეთი:</strong> R134a-სთვის გამოიყენება პოლიეთერული (POE) ზეთი.</li>
				<li><strong class="text-white">ზეოტროპული ნარევი:</strong> იტვირთება მხოლოდ სითხის სახით.</li>
				<li><strong class="text-white">რეციკლირება:</strong> მინარევი არ უნდა აღემატებოდეს 2%-ს.</li>
			</ul>
		</div>
	</div>
</div>
