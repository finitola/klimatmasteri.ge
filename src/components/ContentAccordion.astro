---
interface Props {
	index: number;
	title: string;
	expandLabel: string;
	closeLabel: string;
}

const { index, title, expandLabel, closeLabel } = Astro.props;
---

<details class="group border-b border-white/10">
	<summary class="grid min-h-20 cursor-pointer list-none grid-cols-[2.5rem_minmax(0,1fr)_auto] items-center gap-3 py-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:grid-cols-[4rem_minmax(0,1fr)_auto] sm:gap-5 sm:py-5 [&::-webkit-details-marker]:hidden">
		<span class:list={['font-brand text-small font-extrabold tabular-nums tracking-wider', index % 2 === 1 ? 'text-accent' : 'text-fire']}>{String(index).padStart(2, '0')}</span>
		<h2 class="georgian-caps text-h4 font-bold leading-snug text-white transition-colors group-hover:text-fire group-open:text-fire">{title}</h2>
		<span class="flex shrink-0 items-center gap-2 text-small font-bold text-accent">
			<span class="hidden sm:inline sm:group-open:hidden">{expandLabel}</span>
			<span class="hidden sm:group-open:inline">{closeLabel}</span>
			<svg class="size-5 transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
			</svg>
		</span>
	</summary>
	<div class="pb-8 text-base leading-7 text-white/75 sm:pl-21 sm:leading-8">
		<slot />
	</div>
</details>
